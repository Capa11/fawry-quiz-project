# Copy to .env in the project root and fill in your own values.
# Spring reads this file as Java properties: no quotes and no export prefix.
SECURITY_USER_NAME=your-local-username
SECURITY_USER_PASSWORD=your-local-password
DB_URL=jdbc:postgresql://localhost:5432/quiz?user=your-db-user&password=your-db-password
# Generate a random Base64-encoded key containing at least 32 bytes.
JWT_SECRET=replace-with-your-own-base64-signing-key
GOOGLE_CLIENT_ID=replace-with-your-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-your-google-client-secret
